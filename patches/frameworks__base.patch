+                        controller.setAppVolume(app.key, newVolume)
+                    },
+                )
+            }
+        }
+
+        if (animate) {
+            root.alpha = 0f
+            if (isVolumeDialogVertical) {
+                root.translationX = 12.dpToPx(context)
+            } else {
+                root.translationY = -12.dpToPx(context)
+            }
+        } else {
+            root.alpha = 1f
+            root.translationX = 0f
+            root.translationY = 0f
+        }
+        container.addView(root)
