+    @Override
+    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+        /*
+         * Always measure the expanded presentation first. This is important:
+         * when a previous card/DPI forced compact mode we still need to be
+         * able to return to expanded mode when enough width becomes available.
+         */
+        if (mActionButtons != null && mTaskSize.width() > 0) {
+            if (mCompactActionButtons) {
+                mCompactActionButtons = false;
+                applyActionButtonPresentation(false);
+            }
+
+            super.onMeasure(widthMeasureSpec, heightMeasureSpec);
+
+            final int availableWidth = mTaskSize.width();
+            final boolean compact =
+                    availableWidth > 0
+                            && mActionButtons.getMeasuredWidth() > availableWidth;
+
+            if (compact) {
+                mCompactActionButtons = true;
+                applyActionButtonPresentation(true);
+                super.onMeasure(widthMeasureSpec, heightMeasureSpec);
+            }
+            return;
+        }
+
+        super.onMeasure(widthMeasureSpec, heightMeasureSpec);
+    }
+
+    private void setCompactActionButtons(boolean compact) {
+        if (mCompactActionButtons == compact) {
+            return;
+        }
+        mCompactActionButtons = compact;
+        applyActionButtonPresentation(compact);
+        if (mActionButtons != null) {
+            mActionButtons.requestLayout();
+        }
+    }
+
+    private void applyActionButtonPresentation(boolean compact) {
+        if (mScreenshotButton != null) {
+            mScreenshotButton.setText(
+                    compact ? null : getContext().getText(R.string.action_screenshot));
+            mScreenshotButton.setContentDescription(
+                    compact ? getContext().getText(R.string.action_screenshot) : null);
+            applyActionButtonGeometry(mScreenshotButton, compact);
+        }
+        if (mClearAllButton != null) {
+            mClearAllButton.setText(
+                    compact ? null : getContext().getText(R.string.recents_clear_all));
+            mClearAllButton.setContentDescription(
+                    compact ? getContext().getText(R.string.recents_clear_all) : null);
+            applyActionButtonGeometry(mClearAllButton, compact);
+        }
+    }
+
+    private void applyActionButtonGeometry(Button button, boolean iconOnly) {
+        android.view.ViewGroup.LayoutParams params = button.getLayoutParams();
+        final int actionSize =
+                getResources().getDimensionPixelSize(R.dimen.overview_actions_height);
+
+        if (params != null) {
+            params.width = iconOnly
+                    ? actionSize
+                    : android.view.ViewGroup.LayoutParams.WRAP_CONTENT;
+            params.height = iconOnly
+                    ? actionSize
+                    : android.view.ViewGroup.LayoutParams.WRAP_CONTENT;
+            button.setLayoutParams(params);
+        }
+
+        button.setGravity(android.view.Gravity.CENTER);
+        button.setTextAlignment(View.TEXT_ALIGNMENT_CENTER);
+
+        if (iconOnly) {
+            /*
+             * drawableStart + empty text is not reliably centered by simply
+             * removing padding. Center the actual drawable inside the fixed
+             * 48dp action button.
+             */
+            android.graphics.drawable.Drawable[] drawables =
+                    button.getCompoundDrawablesRelative();
+
+            android.graphics.drawable.Drawable icon = null;
+            for (android.graphics.drawable.Drawable drawable : drawables) {
+                if (drawable != null) {
+                    icon = drawable;
+                    break;
+                }
+            }
+
+            int iconWidth = 0;
+            if (icon != null) {
+                iconWidth = Math.max(0, icon.getIntrinsicWidth());
+            }
+
+            final int horizontalPadding =
+                    Math.max(0, (actionSize - iconWidth) / 2);
+
+            button.setPaddingRelative(
+                    horizontalPadding,
+                    0,
+                    horizontalPadding,
+                    0);
+            button.setCompoundDrawablePadding(0);
+        } else {
+            button.setPaddingRelative(
+                    mExpandedPaddingStart,
+                    mExpandedPaddingTop,
+                    mExpandedPaddingEnd,
+                    mExpandedPaddingBottom);
+            button.setCompoundDrawablePadding(mExpandedDrawablePadding);
+        }
+    }
+
     @Override
     protected void onConfigurationChanged(Configuration newConfig) {
         super.onConfigurationChanged(newConfig);
+        // Re-evaluate the presentation after rotation/configuration changes. Landscape visibility
+        // itself remains controlled by the stock HIDDEN_NON_ZERO_ROTATION path in RecentsView.
+        mCompactActionButtons = false;
+        applyActionButtonPresentation(false);
         updateVerticalMargin(DisplayController.getNavigationMode(getContext()));
     }
 
